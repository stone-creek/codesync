-------------------------------------------------------------------------------
-- Create an NPC at location x,y,z and script some actions.
--
-- In this example, Daniel walks around the starting area
-- Talking to other NPCs, tending the crops and patrolling the entrance.

local daniel = {}
daniel.npc = Machinima.CreateNPC({
    name = "Daniel",
    model = "mesh_model_x",
    gear = ["basic_clothes", "backpack"],
    location = {1000,2000,2500}
})

-------------------------------------------------------------------------------
-- Boredom kicks in sometimes when the NPC isn't doing anything or
-- has been doing the same thing for too long.
daniel.npc.ReactsTo(Boredom, function()
    daniel.FindSomethingToDo()
end)
-------------------------------------------------------------------------------
-- Whenever someone (class = player, NPC, animal, zombie) gets too close to the
-- npc, this is called.
daniel.npc.ReactsTo(Approach, function(who, class)

    -- Switch idiom
    local actions = {
        ["player"]  = daniel.ApproachedByPlayer(who),
        [ "npc"]    = daniel.ApproachedByNPC(who),
        [ "animal"] = daniel.ApproachedByAnimal(who),
        [ "zombie"] = daniel.ApproachedByZombie(who),
        default = function() Game.Error("Unknown type approaching NPC") end
    }

    (actions[class] or actions.default)()

end)
-------------------------------------------------------------------------------
-- Daniel accepts 5 firewood for a campfire kit, unlimited.
daniel.npc.Trades.AcceptTrade(
    {
        item = "campfire",
        --price =                  -- I don't want to hardcode a currency.
                                   -- I'd rather the community creates it's
                                   -- own fiat
        accepts = { "firewood", 5}
    }
)
-------------------------------------------------------------------------------
daniel.npc.Quests.Add(
    conditions = {},
    repeatable = [ Quests.DAILY],  -- undefined or empty = only once per player
    title = "Kill ten rats",
    description = "And don't eat them. Trust me...",
    success = [ { 
        kill = "rat",       -- will look for this worlditem 
        amount = 10
    }],
    success_message = [[
        Thanks for getting rid of some rats! 
        Here's some fresh tomatoes, I hope you like them.
    ]]
    rewards = [ { "tomato", 5 }]
)
-------------------------------------------------------------------------------
daniel.FindSomethingToDo = function()

    -- Randomize something to do
    local whats_next = Utils.RandomFunction(
        daniel.WalksAroundTheArea, 80,   -- 80% chance
        daniel.TendCrops,           5,   -- 5% chance
        daniel.Patrol,             15    -- 15% chance
    )

    whats_next()

end
-------------------------------------------------------------------------------
daniel.WalksAroundTheArea = function()

end
-------------------------------------------------------------------------------
daniel.TendCrops = function()
end
-------------------------------------------------------------------------------
daniel.Patrol = function()
end
-------------------------------------------------------------------------------
daniel.ApproachedByPlayer = function(player)
    -- Says a random greeting message
    Machinima.Speak(AI.VariationOf("good to see you here, %s"))
    Notifications.Add(player, {
        message: "Daniel can trade firewood for campfire kits.",
        dismissable: True,
        unique: True
    })
end
-------------------------------------------------------------------------------
daniel.ApproachedByNPC = function(who)
    -- Random chance to engage in a convo
    if math.random(100) < 20 then
        Machinima.JoinConversation(who)
    end
end
-------------------------------------------------------------------------------
daniel.ApproachedByAnimal = function(who)
    -- 5% chance to shoot an arrow (won't do anything, just scare it off)
    if math.random(100) < 20 then
    end
end
-------------------------------------------------------------------------------
daniel.ApproachedByZombie = function(who)
    -- Run away!
end