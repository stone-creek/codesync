local starting_area = 
    Zones.Create("starting_area", [{1000,2000},{2000,2000},{1500,1500}], 200)

local bridge = Zones.Create("bridge", [], 20) -- ... same but with 20m outskirts

local cursed_area_after_bridge = Zones.Create("cursed_area", [])

-- A spawner needs to be installed as an object under Modules.SPAWNER, disabling
-- the "vanilla" spawner and adding metrics to the monitors.

ZombieSpawner = {}
ZombieSpawner.Respawn = function()

    -- Make sure there's always 30 zombies in the cursed area without spawning too
    -- near any player
    ZombieSpawner.RespawnAt(cursed_area_after_bridge, 30)

    ZombieSpawner.RespawnAt(cursed_area_after_bridge, 30)
end

Game.ReactsTo(Events.OnEveryMinute, ZombieSpawner.Respawn)
Modules.Install(Modules.SPAWNER, "Stein's Vanilla Spawner", ZombieSpawner)
