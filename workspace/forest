MAX_TREES = 15 
SAPLING_CHANCE_EVERY_MINUTE = 20

-------------------------------------------------------------------------------
-- Rotate a vector around its z axis
function rotateZ(x, y, z, degrees)
    local rad = math.rad(degrees)
    local cos = math.cos(rad)
    local sin = math.sin(rad)

    local x2 = x * cos - y * sin
    local y2 = x * sin + y * cos
    local z2 = z

    return x2, y2, z2
end
-------------------------------------------------------------------------------
function translateWorldToRelative(x,y,z,item)

    local coords = WorldItems.GetCoords(item)

    newX,newY,newZ = rotateZ(
        coords.x - x,
        coords.y - y,
        coords.z - z,
        180 - coords.rotation)

    return {
        x = newX,
        y = newY,
        z = 0 - newZ
    }

end
-------------------------------------------------------------------------------
function tokenizeForestPart(str)
    local tokens = {}
    for token in str:gmatch("[^,]+") do
        table.insert(tokens, token:match("^%s*(.-)%s*$")) -- trim whitespace
    end
    return {
        mesh = tokens[1],
        x = tonumber(tokens[2]) or 0,
        y = tonumber(tokens[3]) or 0,
        z = tonumber(tokens[4]) or 0,
        rotation = tonumber(tokens[5]) or 0,
        age = tonumber(tokens[6]) or 0,
        health = tonumber(tokens[7]) or 0
    }
end
-------------------------------------------------------------------------------
function calculateTreeMeshByAge(mesh,age)

    local number = tonumber(mesh:match("^SM_Conifer_(%d+)$"))

    -- Game.Print("mesh:" .. mesh)
    if number ~= nil then

        if math.floor(age / 8000) > number then
            number = number + 1
        end

        if number > 3 then number = 3 end

        return string.format("SM_Conifer_%02d", number)
    end

    return "SM_Conifer_01"
end
-------------------------------------------------------------------------------
function distance3D(v1, v2)
    local dx = v2[1] - v1[1]
    local dy = v2[2] - v1[2]
    local dz = v2[3] - v1[3]
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end
-------------------------------------------------------------------------------
-- Will attempt 100 times to find a suitable nearby position for a new
-- sapling spawn. Will consider Z axis to avoid spawning things in the air.
-- 
function findEmptyLocationNear(coords)
        
    for pos = 1, 100 do
        
        local newX = coords.x + (math.random(6000) - 3000)
        local newY = coords.y + (math.random(6000) - 3000)
        local newZ = Game.GroundAt(newX, newY, coords.z)

        -- Debug.DrawSphere(newX, newY, newZ, 400)

        local valid = true

        local nearest = WorldItems.NearestAt(newX, newY, newZ)
        if (nearest ~= nil) then
            local nearest_coords = WorldItems.GetCoords(nearest)

            local distance = distance3D( 
                {nearest_coords.x, nearest_coords.y, nearest_coords.z}, 
                {newX, newY, newZ} )
       
            if distance < 300 then
                valid = false
            end
        end

        if valid then
            Game.Print("new forest sapling took " .. pos .. " attempts to be located")
            Game.Print(string.format("New location: /debugdot %.0f,%.0f,%.0f",
                newX, newY, newZ))
            return true, newX, newY, newZ
        end
    end

    Game.Print("Warning: could not find suitable location to new forest sapling")
    return false,0,0,0
end
