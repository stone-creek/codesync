function destroyTreeAt(forest,coords)

    local adjusted_coords = WorldItems.GetClosestMeshCoords(coords)
    Game.Print(
        string.format(
            "Destroy tree at called at adjusted coords %.1f,%.1f (original coords %.1f,%.1f)", 
            adjusted_coords.x, adjusted_coords.y,
            coords.x, coords.y))

    local trees = WorldItems.Get(forest, "trees")
    local base_coords = WorldItems.GetCoords(forest)

    local tree = nil

    if trees then

        local tree_found = false

        for treePos, treeString in ipairs(trees) do
            tree = tokenizeForestPart(treeString)

            -- Calculate the distance from the target (coords) and the tree 
            distance = distance3D( 
                {adjusted_coords.x, adjusted_coords.y, 0}, 
                {tree.x, tree.y, 0} )

            if distance < 50 then

                -- Debug.DrawSphere(tree_coords.x,tree_coords.y,tree_coords.z, 200)
                -- Game.Print(string.format("######## SUCCESS removing tree=%f,%f distance = %f...", 
                --     tree.x,tree.y,
                --     distance))
                
                tree_found = true
                break
            end
        end


        if tree_found and tree then
            -- Game.Print("######## TREE FOUND")
            table.remove(trees, treePos)
            WorldItems.Set(forest, "trees", trees)
            WorldItems.DestroyMeshAt(forest,tree.x,tree.y,tree.z)
            return true
        end
    end

    -- Game.Print("######## tree not found")
    return false
end
-------------------------------------------------------------------------------
function OnFinishedChoppingTree(player, forest, coords)

    if destroyTreeAt(forest,coords) then
       
        Inventory.AddTo(player,"lumber")
        Events.Broadcast("forest", "tree.chopped", coords)

        -- maybe a branch?
        if math.random(10) > 6 then
            Inventory.AddTo(player,"branch")
        end

    else
        Players.FlashMessage(player, "No lumber was obtained.")
    end

end
