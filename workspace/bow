Bow = {}
-------------------------------------------------------------------------------
function EquipBow(player)
        
    -- TODO check if theres a bow in the player inventory

    local weapon_info = {
        mesh = "bow",
        class = "bow",
        offset = {0,0,0},
        rotator = {0,0,0},
        scale = 0.5,
        socket = "LeftHandSocket",
        ammo = "arrow",
        on_hit = function(target)
            Bow.OnHitTarget(target)
        end
        -- type = "ranged_1h",
    }

    Players.EquipWeapon(player, weapon_info)
    Players.SetMetadata(player, "equipped", "bow")

end
