    Effects.Glow(new_item, true)

end)
-------------------------------------------------------------------------------
WorldItems.ReactsTo("forage", Events.OnLoad,
function(item_forage)
    Game.Print("AHOY" .. item_forage)
    Effects.Glow(item_forage, true)
end)
-------------------------------------------------------------------------------
WorldItems.ReactsTo("forage", Events.OnClick, 
function(player,clicked_forage)
    options = {}
    -----------------------------------------------------
    menu_check = {
        caption = "Check for items", 
        on_click = function(player, item) 
            Forage.OpenForage(player, clicked_forage)
        end }
    table.insert(options, menu_check)
    -----------------------------------------------------
    Game.Menu(player, clicked_forage, options)
end)
-----------------------------------------------------------
-- 
Forage.OpenForage = function(player, worlditem_forage)

    -- Forage.GetRandomItem()
    local random_item = Forage.GetRandomItem()
    -- Game.Print(random_item.handle)
    
    WorldItems.DespawnItem(worlditem_forage)
    Inventory.AddTo(player, random_item.handle)

    Players.FlashMessage(player, string.format("Obtained: %s", random_item.name))

end