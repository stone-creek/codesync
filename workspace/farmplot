WorldItems.ReactsTo("farmplot", Events.OnEveryMinute,
function()
    -- Game.Print("Everyminute called")

    count = WorldItems.Count("farmplot")
    for pos = 1, count do
        farmplot = WorldItems.At("farmplot", pos)
        age = WorldItems.Get(farmplot, "age")
        type = WorldItems.Get(farmplot, "type")
        oldMesh = calculateMeshByAge(type, age)

        age = age + 1
        newMesh = calculateMeshByAge(type, age)
        if (oldMesh ~= newMesh) then

            despawnPlants(farmplot)
            spawnPlants(farmplot,age)

        end
        WorldItems.Set(farmplot, "age", age)
        -- Game.Print(string.format("New plot age:%d minutes", age))
    end
end)
