-------------------------------------------------------------------------------
-- Current implementation of axe mod (November 2025)
-------------------------------------------------------------------------------
function FindInventoryItem(player, item)

    for pos = 1, Inventory.Count(player) do 
        local inventory = Inventory.At(player, pos)
        if Inventory.ClassOf(player, inventory) == item then
            return inventory
        end
    end

    return nil

end
-------------------------------------------------------------------------------
function UnequipAll(player)

    Players.EquipWeapon(player, nil)
    Players.SetMetadata(player, "equipped", nil)

    -- Remove all dots
    for pos = 1, Inventory.Count(player) do
        local inventory = Inventory.At(player, pos)
        if Inventory.GetDot(player, inventory) then
            Inventory.SetDot(player, inventory, false)
        end
    end

end
-------------------------------------------------------------------------------
function EquipAxe(player)

    local weapon_info = {
        mesh = "axe",
        class = "axe",
        offset = {0,0,-140},
        rotator = {0,90,0},
        scale = 1
    }

    Players.EquipWeapon(player, weapon_info)
    Players.SetMetadata(player, "equipped", "axe")

end
-------------------------------------------------------------------------------
WorldItems.ReactsTo("axe", Events.OnItemUse,
function(player,inventory_guid,class)
    
    -- Possibilities: 
    --     equipping this one: unequip all
    --     equipping another: unequip, equip this
    --     not equipping: equip this

    -- equipping this one
    if Inventory.GetDot(player, inventory_guid) then
        UnequipAll(player)
        return
    end

    UnequipAll(player)

    EquipAxe(player)

    Inventory.SetDot(player, inventory_guid, true)
end)

-------------------------------------------------------------------------------
Game.SubscribeTo(Events.OnPlayerOnline, function(player)

    Game.Print("Retrieving metadata for player=" .. player)
    local metadata = Players.GetMetadata(player, "equipped")

    if metadata ~= nil then
        Game.Print("metadata:" .. metadata)
    end
        
    if metadata == "axe" then

        inventory_guid = FindInventoryItem(player, "axe") 
        if inventory_guid then
            EquipAxe(player)
            Inventory.SetDot(player, inventory_guid, true)
        else
            Game.Print("Error: could not find equipped axe in inventory")
            Players.SetMetadata(player, "equipped", nil)
        end

    end

end)